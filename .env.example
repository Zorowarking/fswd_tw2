# ==============================================================================
# CampusServe - Smart Campus Service Booking and Management System
# Production & Development Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain these from your Neon Console (https://console.neon.tech)
# Use the pooled connection string (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-campus-serverless-pooler.us-east-2.aws.neon.tech/campusserve?sslmode=require"
# Use the unpooled direct connection string (port 5432) for DIRECT_URL (Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-campus-serverless.us-east-2.aws.neon.tech/campusserve?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
# Obtain from Clerk Dashboard (https://dashboard.clerk.com) -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_campusserve_placeholder_publishable_key"
CLERK_SECRET_KEY="sk_test_campusserve_placeholder_secret_key"
# Local Networkless JWT Verification Key (JWKS Public Key from Clerk Dashboard)
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Clerk Route Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/auth-redirect"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/auth-redirect"

# Clerk Webhook Secret (Obtain from Clerk Dashboard -> Webhooks -> Endpoint Signing Secret)
CLERK_WEBHOOK_SECRET="whsec_campusserve_placeholder_secret"

# ------------------------------------------------------------------------------
# 3. PAYMENTS GATEWAY (Razorpay Test Mode)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard (https://dashboard.razorpay.com) -> Settings -> API Keys (Generate Test Key)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_campusserve_key_id"
RAZORPAY_KEY_ID="rzp_test_campusserve_key_id"
RAZORPAY_KEY_SECRET="rzp_test_campusserve_key_secret"

# ------------------------------------------------------------------------------
# 4. APPLICATION METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
